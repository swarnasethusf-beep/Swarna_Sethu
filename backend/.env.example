# =====================================================================
# Swarna Sethu — Backend environment (copy to .env and fill in)
# .env is git-ignored. Never commit real values.
# =====================================================================

PORT=5000

# Firebase service account (Firebase console → Project settings → Service accounts → Generate new private key).
# Local: save the file as backend/serviceAccountKey.json (git-ignored) and leave FIREBASE_SERVICE_ACCOUNT as is.
FIREBASE_SERVICE_ACCOUNT=serviceAccountKey.json
# Vercel: there is no file, so paste the key here instead — the base64 of the JSON file is the safest form.
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json")) | Set-Clipboard
#   Mac/Linux:   base64 -w0 serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# AES-256 key for stored license keys — EXACTLY 32 characters.
# Do not change after first run (stored keys could no longer be decrypted).
ENCRYPTION_SECRET=

# HMAC secret for login sessions — at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out.
TOKEN_SECRET=

# License admin portal login. Generate the hash with:
#   node scripts/hash-password.js "your-strong-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Fast2SMS key for OTP SMS. Leave empty in development: OTPs are printed to the console.
FAST2SMS_API_KEY=

# GoldAPI.io key for the "fetch live rate" button (optional).
GOLDAPI_KEY=

# Browser origins allowed to call the API (comma separated, no trailing slash).
# "null" is the origin of the packaged Electron app (file://).
# On Vercel: add the two website URLs, e.g. https://swarna-sethu-billing.vercel.app,https://swarna-sethu-admin.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,null
